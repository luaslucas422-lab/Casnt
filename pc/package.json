{
  "name": "casnt",
  "productName": "Casnt",
  "version": "0.3.1",
  "description": "Cast your Meta Quest 3 to your PC.",
  "author": "calm.chasm",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.calmchasm.casnt",
    "productName": "Casnt",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Casnt",
      "artifactName": "Casnt-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "perMachine": true
    },
    "portable": {
      "artifactName": "Casnt-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luaslucas422-lab",
        "repo": "Casnt"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/adb",
        "to": "adb",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "tiktok-live-connector": "^2.5.0"
  }
}
